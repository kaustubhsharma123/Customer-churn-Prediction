# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Virtual environments ---
venv/
.venv/

# --- Secrets / local config ---
.env
.streamlit/secrets.toml

# --- Tooling caches ---
.pytest_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# --- Data: raw data is ignored by default (licence/size decided in Phase 2);
#     processed data is reproducible from code. Folders kept via .gitkeep. ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Model artifacts: build outputs of `python -m churn.train` (deterministic from
#     the locked decision in reports/locked_decisions_tuned.json), never committed ---
models/*.joblib
models/*.pkl
models/*.json

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
